rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.id == roomId
        && request.resource.data.roomCode == roomId
        && request.resource.data.status == 'waiting';
      allow update, delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }
    match /members/{memberId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && (
          (request.resource.data.role == 'student'
            && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)))
          || (request.resource.data.role == 'teacher'
            && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.teacherId == request.auth.uid)
        );
      allow update, delete: if false;
    }
  }
}
